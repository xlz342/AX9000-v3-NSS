#!/bin/sh
# Leave network, radios, country and txpower at official defaults.
uci -q set luci.main.mediaurlbase='/luci-static/argon'
uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit luci
uci -q commit firewall
# OpenSSH is preinstalled but disabled to avoid a Dropbear port 22 collision.
# Enable OpenSSH after installing a public key, as documented in README.
/etc/init.d/sshd disable
exit 0
