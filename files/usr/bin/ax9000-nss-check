#!/bin/sh
echo '=== Identity and partitions (read only) ==='
ubus call system board
cat /proc/mtd
echo '=== Services/modules ==='
lsmod | grep -E 'ecm|qca_nss|ath11k'
echo "Nikki enabled: $(uci -q get nikki.config.enabled)"
echo '=== firewall4 ==='
fw4 check
nft list ruleset
echo '=== NSS boot log ==='
dmesg | grep -iE 'nss|ecm|ath11k|qcn|calibration|firmware'
echo '=== Acceleration counters: run twice DURING LAN-to-WAN traffic ==='
for p in /sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count /sys/kernel/debug/ecm/ecm_nss_ipv6/accelerated_count; do
  [ -r "$p" ] && { echo "$p"; cat "$p"; }
done
for p in /sys/kernel/debug/qca-nss-drv/stats/ipv4 /sys/kernel/debug/qca-nss-drv/stats/ipv6; do
  [ -r "$p" ] && { echo "$p"; cat "$p"; }
done
echo '=== Wireless capabilities ==='
iw phy
echo '=== SSH key algorithms ==='
[ -x /usr/bin/ssh-keygen ] && ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
